{
  "name": "fortify-renewal-evidence-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern output --ignore-pattern test-results",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:migration": "vitest run tests/migration.test.ts",
    "test:e2e": "playwright test",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "db:generate": "drizzle-kit generate",
    "demo:reset": "node --import tsx scripts/reset-demo.ts",
    "demo:evaluate": "node --import tsx scripts/evaluate-demo.ts",
    "artifacts:generate": "node --import tsx scripts/generate-artifacts.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run security:secrets && npm run build && npm run demo:evaluate && npm run test:e2e"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "0.45.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "^6.1.0",
    "next": "^16.2.12",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.12",
    "postcss": "8.5.18",
    "prettier": "^3.6.2",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.3"
  },
  "type": "module"
}
