{
  "name": "fortify-resilience-recognition-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern output --ignore-pattern test-results --ignore-pattern playwright-report",
    "format:check": "prettier --check proxy.ts app/api/ready/route.ts lib/production/environment.ts lib/production/observability.ts lib/production/rate-limit.ts lib/production/encrypted-backup.ts scripts/backup-production.ts scripts/restore-production.ts scripts/run-bounded-tests.mjs scripts/validate-production-flow.mjs scripts/validate-operations.mjs tests/operational-hardening.test.ts e2e/operational-hardening.spec.ts .github/workflows/ci.yml .github/workflows/release.yml docs/SECURITY_AND_PRIVACY.md docs/THREAT_MODEL.md docs/DATA_FLOW.md docs/OPERATIONS_RUNBOOK.md docs/INCIDENT_RESPONSE.md docs/BACKUP_RESTORE_REPORT.md docs/PAID_PILOT_RUNBOOK.md docs/ROI_MEASUREMENT.md docs/LAUNCH_READINESS.md docs/SECURITY_QUESTIONNAIRE.md docs/SUBPROCESSORS.md docs/production-flow-evidence.json",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:bounded": "node scripts/run-bounded-tests.mjs",
    "test:migration": "vitest run tests/migration.test.ts",
    "test:e2e": "playwright test",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:claims": "node scripts/scan-prohibited-claims.mjs",
    "db:generate": "drizzle-kit generate",
    "db:generate:production": "drizzle-kit generate --config drizzle-production.config.ts",
    "db:migrate:production": "node --import tsx scripts/migrate-production.ts",
    "db:seed:production-sandbox": "node --import tsx scripts/seed-production-sandbox.ts",
    "db:backup:production": "node --import tsx scripts/backup-production.ts",
    "db:restore:production": "node --import tsx scripts/restore-production.ts",
    "worker:documents:once": "node --import tsx scripts/run-document-worker.ts",
    "demo:reset": "node --import tsx scripts/reset-demo.ts",
    "demo:evaluate": "node --import tsx scripts/evaluate-demo.ts",
    "artifacts:generate": "node --import tsx scripts/generate-artifacts.ts",
    "validate:production-flow": "node scripts/validate-production-flow.mjs",
    "validate:operations": "node scripts/validate-operations.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:bounded && npm run validate:production-flow && npm run validate:operations && npm run security:secrets && npm run build && npm run demo:evaluate && npm run security:claims && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "better-sqlite3": "^13.0.2",
    "csv-parse": "^7.0.1",
    "drizzle-orm": "0.45.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "^6.1.0",
    "next": "^16.2.12",
    "openid-client": "^6.8.4",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "read-excel-file": "^9.3.5",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.12",
    "postcss": "8.5.18",
    "prettier": "^3.6.2",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "postcss": "8.5.18",
    "sharp": "0.35.3"
  },
  "type": "module"
}
