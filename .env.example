FORTIFY_RUNTIME_MODE=sandbox
FORTIFY_DATABASE_PATH=./data/fortify.sqlite
FORTIFY_STORAGE_PATH=./storage/evidence
FORTIFY_OUTPUT_PATH=./output
NEXT_PUBLIC_DEMO_MODE=true

# Production mode is fail closed and requires a real PostgreSQL connection.
# FORTIFY_RUNTIME_MODE=production
# DATABASE_URL=postgresql://fortify:replace-me@127.0.0.1:5432/fortify
# FORTIFY_APP_ORIGIN=https://fortify.example.com
# FORTIFY_OIDC_PROVIDER_KEY=brokerage-oidc
# FORTIFY_OIDC_ISSUER=https://identity.example.com/
# FORTIFY_OIDC_CLIENT_ID=replace-me
# FORTIFY_OIDC_CLIENT_SECRET=replace-me
# FORTIFY_STORAGE_BUCKET=private-evidence-bucket
# FORTIFY_STORAGE_REGION=us-west-2
# FORTIFY_STORAGE_ENDPOINT=https://object-provider.example.com
# FORTIFY_STORAGE_FORCE_PATH_STYLE=true
# FORTIFY_STORAGE_KMS_KEY_ID=alias/fortify-evidence
# FORTIFY_DOCUMENT_PROVIDER=local-selectable-text
# FORTIFY_REQUEST_HASH_KEY=generate-at-least-32-random-characters
# FORTIFY_DATABASE_POOL_MAX=10
# FORTIFY_DATABASE_CONNECT_TIMEOUT_MS=5000
# FORTIFY_DATABASE_IDLE_TIMEOUT_MS=30000
# FORTIFY_DATABASE_QUERY_TIMEOUT_MS=15000
# FORTIFY_DATABASE_STATEMENT_TIMEOUT_MS=15000
# FORTIFY_BACKUP_ENCRYPTION_KEY_REFERENCE=secret-manager://fortify/backup-key
# FORTIFY_BACKUP_BUCKET=private-fortify-backups
# FORTIFY_RELEASE_ENVIRONMENT=staging
# FORTIFY_RELEASE_SHA=git-commit-sha

# Run the durable document worker as a separately scoped service account.
# FORTIFY_WORKER_ORGANIZATION_ID=org-replace-me
# FORTIFY_WORKER_SUBJECT=document-worker
# FORTIFY_WORKER_ID=document-worker-1

# Local identity is an explicit non-production adapter and is disabled by default.
# FORTIFY_LOCAL_IDENTITY_ENABLED=true
